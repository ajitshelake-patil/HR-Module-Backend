PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hhc_recruitment

# Optional - keeps users signed in. Any long random text.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Frontend URL - used to build the candidate offer link
FRONTEND_URL=http://localhost:5173

# Offer link validity (days)
OFFER_LINK_VALID_DAYS=15

# ---------------- Email (offer & appointment letters) ----------------
# Gmail / Google Workspace : SMTP_HOST=smtp.gmail.com     SMTP_PORT=587  (use an App Password)
# Microsoft 365 / Outlook  : SMTP_HOST=smtp.office365.com SMTP_PORT=587
# Zoho Mail                : SMTP_HOST=smtp.zoho.in       SMTP_PORT=465
# Leave SMTP_HOST empty to switch email off (HR can still copy the link / WhatsApp it).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Healing Hands HR <hr@example.com>"
# Optional: copy every candidate email to HR (comma separated)
MAIL_CC=
MAIL_BCC=

# Company details printed on letters
COMPANY_NAME=Healing Hands Clinic
COMPANY_LEGAL_NAME=Healing Hands Clinic Private Limited
COMPANY_ADDRESS=Pune, Maharashtra

# Letters: signatory printed at the end of offer / appointment letters, and page footer
HR_SIGNATORY_NAME=Mr. Sagar Shekhar
HR_SIGNATORY_DESIGNATION=Head – Human Resources
LETTER_FOOTER_TEXT=Healing Hands Clinic Private Limited | Confidential

# Employee codes: one shared HHCPL series for employees + consultants.
# Last code already issued in the old register; the app continues from the next number (1630 -> HHCPL1631).
EMPLOYEE_CODE_START_AFTER=1630
